{
  "name": "world-clock",
  "version": "0.1.0",
  "description": "Live world clocks for Logitech MX Creative Console keys (Logi Actions SDK, Node.js)",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "npm run typecheck && tsup",
    "build:pack": "npm run build:prod && npm run pack",
    "build:prod": "npm run typecheck && cross-env NODE_ENV=production tsup",
    "icon": "sips -s format png design/icon.svg --out package/metadata/Icon256x256.png",
    "shapes": "node scripts/generate-shapes.mjs",
    "pack": "logitoolkit pack",
    "link": "logitoolkit link",
    "typecheck": "tsc --noEmit",
    "unlink": "logitoolkit unlink",
    "watch": "npm run typecheck && tsup --watch"
  },
  "author": "Vainayaga Sundara Moorthy <vinayeswaras@live.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@logitech/plugin-sdk": "0.1.1"
  },
  "devDependencies": {
    "@logitech/plugin-toolkit": "0.1.1",
    "@types/node": "^22.18.8",
    "cross-env": "^7.0.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
